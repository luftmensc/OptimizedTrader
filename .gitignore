# Ignore build directory
/build/
/output/*
!output/
# Ignore the paper trading data and results (see scripts/paper_trader.py)
/paper/
# Ignore downloaded market data (see scripts/binance_fetch.py), keep the sample
/input/*
!/input/ALGOUSDT.csv
# Ignore object files
*.o
*.obj

# Ignore compiled dynamic libraries
*.so
*.dylib
*.dll

# Ignore compiled static libraries
*.a
*.lib

# Ignore compiled executables
*.exe
*.out

# Ignore temporary files created by the editor
*.swp
*~
*.swo
.DS_Store

# Ignore logs
*.log

# Ignore Visual Studio Code workspace settings
.vscode/

# Ignore Python bytecode files
__pycache__/
*.py[cod]
*.ps
*.Identifier